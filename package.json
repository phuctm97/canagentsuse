{
  "name": "canagentsuse-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run catalog:build && cd packages/website && bun run dev",
    "build": "bun run catalog:build && cd packages/website && bun run build",
    "start": "cd packages/website && bun run start",
    "catalog:build": "node scripts/build-catalog.mjs",
    "catalog:build:check": "node scripts/build-catalog.mjs --check",
    "catalog:source:check": "node scripts/validate-catalog-sources.mjs",
    "catalog:format": "node scripts/format-catalog.mjs && bun run catalog:build",
    "catalog:format:check": "node scripts/format-catalog.mjs --check",
    "catalog:audit": "cd packages/website && bun run catalog:audit",
    "website:dev": "cd packages/website && bun run dev",
    "website:build": "cd packages/website && bun run build",
    "website:start": "cd packages/website && bun run start",
    "website:typecheck": "cd packages/website && bun run typecheck",
    "agent-surfaces:test": "cd packages/website && bun run test:agent-surfaces",
    "cli:build": "cd packages/cli && bun run build",
    "cli:test": "cd packages/cli && bun run test",
    "cli:typecheck": "cd packages/cli && bun run typecheck",
    "cli:pack": "cd packages/cli && bun run pack:dry-run",
    "release:cli:check": "bun run catalog:build && bun run catalog:audit && bun run cli:test && bun run cli:pack",
    "release:plan": "node scripts/release-plan.mjs",
    "release:detect-version": "node scripts/detect-version-release.mjs",
    "release:sync-cli-version": "node scripts/sync-cli-version.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "changeset:version": "changeset version && bun run release:sync-cli-version",
    "changeset:publish": "changeset publish",
    "typecheck": "bun run website:typecheck && bun run cli:typecheck",
    "check": "bun run catalog:build && bun run typecheck && bun run catalog:source:check && bun run catalog:build:check && bun run catalog:format:check && bun run catalog:audit && bun run agent-surfaces:test && bun run cli:test && bun run build",
    "validate": "bun run check && bun run cli:pack && git diff --check",
    "validate:ci": "bun run validate && node scripts/validate-commit.mjs"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  }
}
